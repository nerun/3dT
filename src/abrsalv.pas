procedure printfile;
type personagem=record
     nomearq : string[255];
     nome:string[40];
     forca:string[5];
     habilidade:string[5];
     resistencia:string[5];
     armadura:string[5];
     poderdefogo:string[5];
     fogo:string[5];
     terra:string[5];
     agua:string[5];
     ar:string[5];
     luz:string[5];
     trevas:string[5];
     nu_vants:integer;
     nu_dvs:integer;
     nu_observs:integer;
     vants:array[0..9] of string[40];
     dvs:array[0..9] of string[40];
     figura:string[255];
     observs:array[0..9] of string[255];
end;
personagemfile=file of personagem;
var pers:personagem;
    i:integer;
    Fileaberto,Filesalvo:personagemfile;
    figurapontopicture:string[255];
    mudou : boolean;
implementation
uses main;
procedure savefile(filenome:string);
begin
pers.nomearq:=filenome;
assignfile(Filesalvo,pers.nomearq);
rewrite(Filesalvo);
pers.nome:=frmMain.tx_nome.text;
pers.forca:=frmMain.tx_forca.text;
pers.habilidade:=frmMain.tx_habilidade.text;
pers.resistencia:=frmMain.tx_resistencia.text;
pers.armadura:=frmMain.tx_armadura.text;
pers.poderdefogo:=frmMain.tx_poderdefogo.text;
pers.fogo:=frmMain.tx_fogo.text;
pers.terra:=frmMain.tx_terra.text;
pers.agua:=frmMain.tx_agua.text;
pers.ar:=frmMain.tx_ar.text;
pers.luz:=frmMain.tx_luz.text;
pers.trevas:=frmMain.tx_trevas.text;
pers.nu_vants:=frmMain.ls_vant_adq.items.count -1;
pers.nu_dvs:=frmMain.ls_dv_adq.items.count -1;
pers.nu_observs:=frmMain.mm_observ.lines.count -1;
for i:=0 to frmMain.ls_vant_adq.items.count -1 do
    pers.vants[i]:=frmMain.ls_vant_adq.items[i];
for i:=0 to frmMain.ls_dv_adq.items.count -1 do
    pers.dvs[i]:=frmMain.ls_dv_adq.items[i];
pers.figura:=figurapontopicture;
for i:=0 to frmMain.mm_observ.lines.count -1 do
    pers.observs[i]:=frmMain.mm_observ.lines[i];
write(Filesalvo,pers);
closefile(Filesalvo);
end;

procedure abrirfile(filenome:string);
var costs,cost,code,i:integer;
    cat:string;
begin
pers.nomearq:=filenome;
assignfile(Fileaberto,pers.nomearq);
reset(Fileaberto);
read(Fileaberto,pers);
frmMain.tx_nome.text:=pers.nome;
frmMain.tx_forca.text:=pers.forca;
frmMain.tx_habilidade.text:=pers.habilidade;
frmMain.tx_resistencia.text:=pers.resistencia;
frmMain.tx_armadura.text:=pers.armadura;
frmMain.tx_poderdefogo.text:=pers.poderdefogo;
frmMain.tx_fogo.text:=pers.fogo;
frmMain.tx_terra.text:=pers.terra;
frmMain.tx_agua.text:=pers.agua;
frmMain.tx_ar.text:=pers.ar;
frmMain.tx_luz.text:=pers.luz;
frmMain.tx_trevas.text:=pers.trevas;
figurapontopicture:=pers.figura;
if fileexists(pers.figura) then frmMain.figura.picture.loadfromfile(pers.figura) else frmMain.figura.picture:=frmMain.modelo.picture;
frmMain.ls_vant_adq.items.clear;
frmMain.ls_dv_adq.items.clear;
frmMain.mm_observ.lines.clear;
for i:=0 to pers.nu_vants do
    frmMain.ls_vant_adq.items.add(pers.vants[i]);
for i:=0 to pers.nu_dvs do
    frmMain.ls_dv_adq.items.add(pers.dvs[i]);
for i:=0 to pers.nu_observs do
    frmMain.mm_observ.lines.add(pers.observs[i]);
    frmmain.supercalctotal;
    closefile(fileaberto);
end;
